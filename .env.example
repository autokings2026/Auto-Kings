# ═══════════════════════════════════════════════════════════════
# Kings Auto Diagnósticos — Plantilla de Variables de Entorno
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env a git. Solo .env.example va al repositorio.
# ═══════════════════════════════════════════════════════════════

# ─── Base de Datos (Supabase PostgreSQL) ────────────────────────
# Obtener desde: supabase.com → Project → Settings → Database
# DATABASE_URL  → Transaction pooler (puerto 6543, pgbouncer=true)
# DIRECT_URL    → Conexión directa (puerto 5432, para migraciones)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ─── NextAuth.js ─────────────────────────────────────────────────
# Genera con: openssl rand -base64 64
NEXTAUTH_SECRET="CAMBIA_ESTO_EN_PRODUCCION"
NEXTAUTH_URL="http://localhost:3000"   # En Vercel: https://tu-app.vercel.app

# ─── Cloudinary (fotos de vehículos) ────────────────────────────
# Obtener desde: cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="tu_cloud_name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="tu_upload_preset"  # Unsigned preset

# ─── Resend (emails transaccionales) ────────────────────────────
# Obtener desde: resend.com → API Keys
RESEND_API_KEY="re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
RESEND_FROM_EMAIL="noreply@tudominio.com"

# ─── App ─────────────────────────────────────────────────────────
JWT_SECRET="CAMBIA_ESTO_EN_PRODUCCION"
NEXT_PUBLIC_APP_URL="http://localhost:3000"   # En Vercel: https://tu-app.vercel.app
NEXT_PUBLIC_APP_NAME="Kings Auto Diagnósticos"
NEXT_PUBLIC_WHATSAPP_NUMBER="50499999999"     # Código país + número sin +
NEXT_PUBLIC_CURRENCY_CODE="HNL"
NEXT_PUBLIC_CURRENCY_SYMBOL="L."
