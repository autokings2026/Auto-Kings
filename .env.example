# ═══════════════════════════════════════════════════════════════
# Kings Auto Diagnósticos — Variables de Entorno
# ═══════════════════════════════════════════════════════════════
# Copia este archivo a .env (raíz) y rellena los valores reales.
# NUNCA subas .env a git. Solo .env.example va al repositorio.
# ═══════════════════════════════════════════════════════════════

# ─── Base de Datos (PostgreSQL) ─────────────────────────────────
# Railway: se obtiene desde el panel del plugin PostgreSQL
# Local:   postgresql://postgres:password@localhost:5432/kings_auto
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ─── JWT / Sesiones ──────────────────────────────────────────────
# Genera con: openssl rand -base64 64
JWT_SECRET="CAMBIA_ESTO_EN_PRODUCCION"
JWT_EXPIRES_IN="8h"

# NextAuth.js (apps/web)
# Genera con: openssl rand -base64 64
NEXTAUTH_SECRET="CAMBIA_ESTO_EN_PRODUCCION"
NEXTAUTH_URL="http://localhost:3000"   # En Railway: https://tu-app.railway.app

# ─── Cloudinary (fotos de vehículos + logo del taller) ──────────
# Obtener desde: cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"
# Carpetas usadas:
#   kings-auto/fotos-ingreso   → fotos de OTs
#   kings-auto/logos           → logo del taller
CLOUDINARY_UPLOAD_PRESET="kings_auto_preset"  # crear en Cloudinary dashboard (unsigned preset)

# ─── Resend (emails transaccionales) ────────────────────────────
# Obtener desde: resend.com → API Keys
RESEND_API_KEY="re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# Email remitente (debe estar verificado en Resend)
EMAIL_FROM="Kings Auto Diagnósticos <noreply@kingsauto.hn>"
EMAIL_FROM_NAME="Kings Auto Diagnósticos"

# ─── URLs de la aplicación ───────────────────────────────────────
# URL del backend NestJS (apps/api)
API_URL="http://localhost:3001"
# URL pública del backend (accesible desde el navegador y desde web)
NEXT_PUBLIC_API_URL="http://localhost:3001"
# URL del frontend Next.js (para links en emails y encuestas)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── WhatsApp del taller ─────────────────────────────────────────
# Número del taller SIN el símbolo + (para construir links wa.me)
# Ejemplo Honduras: 50499999999 (504 = código país + número local)
NEXT_PUBLIC_WHATSAPP_NUMBER="50499999999"

# ─── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Kings Auto Diagnósticos"
NEXT_PUBLIC_APP_COUNTRY="HN"
NEXT_PUBLIC_CURRENCY_CODE="HNL"
NEXT_PUBLIC_CURRENCY_SYMBOL="L."

# ─── NestJS (apps/api) ───────────────────────────────────────────
PORT=3001
NODE_ENV="development"   # development | production

# ─── Cron jobs (NestJS Schedule) ────────────────────────────────
# Zona horaria de Honduras (America/Tegucigalpa = UTC-6, sin DST)
TZ="America/Tegucigalpa"

# ─── Railway (solo para referencia del deploy) ───────────────────
# Estas variables las inyecta Railway automáticamente en producción.
# No las configures manualmente aquí.
# RAILWAY_STATIC_URL
# RAILWAY_PUBLIC_DOMAIN
# PORT (Railway asigna el puerto automáticamente)
